  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89555f732743d9643aad5c65a5c131cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LabsVR.Lab6SceneInfo
  description: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0439 \u0430\u0440\u0445\u0456\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u0438\u0439 \u043F\u0440\u043E\u0441\u0442\u0456\u0440. \u0421\u0456\u043C \u0440\u0456\u0437\u043D\u0438\u0445 \u0433\u043E\u0442\u043E\u0432\u0438\u0445 \u0431\u0443\u0434\u0456\u0432\u0435\u043B\u044C PolygonCity, \u0432\u043B\u0430\u0441\u043D\u0435 \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u043F\u043B\u043E\u0449\u0456 \u0442\u0430 \u043F\u0430\u0432\u0456\u043B\u044C\u0439\u043E\u043D \u0432\u043B\u0430\u0441\u0442\u0438\u0432\u043E\u0441\u0442\u0435\u0439 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432.\n\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430 6: \u0441\u0435\u0440\u0435\u0434\u043E\u0432\u0438\u0449\u0435, 3D-\u043E\u0431'\u0454\u043A\u0442\u0438, \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0438. \u041E\u0441\u043D\u043E\u0432\u0430 \u0434\u043B\u044F \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0438\u0445 VR-\u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0438\u0445."
